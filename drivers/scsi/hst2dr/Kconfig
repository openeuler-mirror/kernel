config SCSI_HST2DR
	tristate "HST2DR Device Driver"
	depends on PCI && SCSI
	select SCSI_SAS_ATTRS
	select RAID_ATTRS
	help
	  This driver supports PCI-Express SAS 12Gb/s Host Adapters.

